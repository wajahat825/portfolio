PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Local MongoDB (docker compose up -d) or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio
# Optional: email notifications. Messages are saved to MongoDB either way.
# SMTP account used to send you the contact messages (for Gmail use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password
# Where contact messages are delivered
CONTACT_TO=wajahathsaqqi@gmail.com
